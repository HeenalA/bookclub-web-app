  "reviews": [
    { "memberId": "maya",   "bookId": 77, "text": "Really interesting concept — loved how the women banded together. The humor was sharp and unexpected for the subject matter." },
    { "memberId": "mina",   "bookId": 77, "text": "Loved the dynamic between all the women. Funny and sharp with real emotional weight underneath it all." },

    { "memberId": "maya",   "bookId": 72, "text": "A classic. Short. Festive. No notes." },
    { "memberId": "mina",   "bookId": 72, "text": "Wonderful. Perfect meeting book. Heenal's best pick arguably." },
    { "memberId": "heenal", "bookId": 72, "text": "Iconic. A delight. The Grinch understood the assignment completely." },

    { "memberId": "maya",   "bookId": 66, "text": "Really good. The world was very confusing and the plot could have been refined a bit. But the characters were great and the plot was very interesting. Very unique." },
    { "memberId": "mina",   "bookId": 66, "text": "Such an interesting world. Felt in some ways like Attack on Titan despite the fact I've only seen one episode of it. Very unique and complicated magic system." },
    { "memberId": "heenal", "bookId": 66, "text": "A good fantasy." },

    { "memberId": "maya",   "bookId": 58, "text": "Disliked how nothing seemed to matter. The time jumping made it so there was never any character growth and there were lots of loose ends. No climax." },
    { "memberId": "mina",   "bookId": 58, "text": "Kinda slow. Esme was a very passive main character and did not change a lot. Favorite character was her short-lived husband. Plot was fairly non-existent." },
    { "memberId": "heenal", "bookId": 58, "text": "From the premise I was hoping for more character development and an actual story. The main character lacked development so there was nothing super likable or compelling there." }
