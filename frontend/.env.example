# Copy to `.env.local` and fill in. `.env.local` is gitignored.
#
# LEARNING: Vite only exposes variables prefixed with VITE_ to browser code.
# That prefix is a safety rail — it means you cannot leak a server secret into
# the bundle by accident, because anything without the prefix is simply not
# there at build time.
#
# Both values below are safe to expose: the URL is public, and the anon key is
# designed to be public. Real access control lives in the Row Level Security
# policies in db/migrations/0005_rls.sql.
#
# NEVER put the service_role key in here. It bypasses RLS entirely and must
# only ever exist server-side.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
